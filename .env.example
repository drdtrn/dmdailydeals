# Copy to .env and fill in. Never commit .env.

# Postgres (matches docker-compose.yml for local dev)
DATABASE_URL=postgresql://dmdd:dmdd_dev@127.0.0.1:5433/dmdailydeals

# Used to encrypt Payload JWT tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Public site URL. No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Bearer secret the cron runner sends to /api/payload-jobs/run. Generate with: openssl rand -hex 32
CRON_SECRET=

# Where jobs call the app itself (cache warm-up after a drop). Default: http://127.0.0.1:$PORT (3000).
# In production the job runs inside the web container, so the default is right.
# INTERNAL_SERVER_URL=http://127.0.0.1:3000

# IndexNow (Bing, Yandex, ...). 8-128 chars of a-zA-Z0-9-. Generate with: openssl rand -hex 16
# The app serves the key at <site>/indexnow-key.txt (404 while unset) and sends that URL as the
# keyLocation, so no key file is committed. With it unset, or a localhost site URL, the ping is a no-op.
# INDEXNOW_KEY=

# Secret for draft/live preview requests. Generate with: openssl rand -hex 32
PREVIEW_SECRET=


# Directory for uploaded media (absolute path). Defaults to <repo>/media (gitignored).
# In production, point this at the mounted volume, e.g. /data/media
# PAYLOAD_MEDIA_DIR=

# Schema management. Leave unset for the local dev database (Payload pushes the schema).
# Set to false for any migration-managed database (CI, production): push is disabled and, in
# production, the committed migrations run on startup. Never mix push and migrations on one database.
# PAYLOAD_DB_PUSH=false

# Integration tests use their own database so they never touch your dev data.
# Default: DATABASE_URL with "_test" appended to the database name (dmdailydeals_test).
# Create it once: docker exec dmdailydeals-postgres-1 psql -U dmdd -d postgres -c 'CREATE DATABASE dmdailydeals_test'
# TEST_DATABASE_URL=postgresql://dmdd:dmdd_dev@127.0.0.1:5433/dmdailydeals_test

# --- Phase 7: audience and analytics ---

# Umami (self-hosted analytics; the server itself arrives with the Docker Compose stack).
# The script loads only when BOTH are set. NEXT_PUBLIC_* values are inlined at BUILD time, so they
# must be present when `pnpm build` / the image build runs.
# NEXT_PUBLIC_UMAMI_SRC=https://stats.dmdailydeals.com/script.js
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Hostnames Umami counts (data-domains). Default: the host of NEXT_PUBLIC_SERVER_URL, so local
# and preview traffic is ignored. Set to a comma separated list to also count e.g. the www host.
# NEXT_PUBLIC_UMAMI_DOMAINS=

# Telegram channel posts. Without both of these, or with "Post drops to Telegram" off in Site
# settings, the job does nothing. Channel id is @channelname (public channel) or -100xxxxxxxxxx.
# See the README ("Telegram channel") for setup. Never commit the token.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID=@dmdailydeals

# --- Phase 8: blog drafts (AI) ---
# The provider layer (src/ai/provider.ts) speaks OpenAI's request format to DeepSeek or OpenAI.
# Choices (on/off, provider, model, monthly cap) live in Site settings > AI blog drafts; secrets live here.
# SET A MONTHLY SPEND LIMIT in each provider's console before turning drafts on (decision D9).
#
# Which provider to use when Site settings leave it empty: deepseek | openai (default deepseek)
# AI_PROVIDER=deepseek
# API key for the chosen provider. Never commit these.
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# Optional overrides: a different endpoint (e.g. a gateway) and a model id. AI_MODEL beats Site settings.
# Defaults: deepseek-flash / gpt-6-luna. Re-check model ids and prices (plan section D) before use.
# AI_BASE_URL=
# AI_MODEL=
# Tavily search key for the research step (basic search; free tier of 1,000 credits a month).
# TAVILY_API_KEY=

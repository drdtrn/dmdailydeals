# Copy to .env and fill in. Never commit .env.

# Postgres (matches docker-compose.yml for local dev)
DATABASE_URL=postgresql://dmdd:dmdd_dev@127.0.0.1:5433/dmdailydeals

# Used to encrypt Payload JWT tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Public site URL. No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Bearer secret the cron runner sends to /api/payload-jobs/run. Generate with: openssl rand -hex 32
CRON_SECRET=

# Secret for draft/live preview requests. Generate with: openssl rand -hex 32
PREVIEW_SECRET=


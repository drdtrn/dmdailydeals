# Production environment. On the VPS: cp .env.production.example .env.production, fill every value,
# chmod 600 .env.production. NEVER commit .env.production (it is gitignored).
#
# Use only [A-Za-z0-9] values for passwords and secrets (openssl rand -hex ...): they go into URLs
# and need no escaping. No quotes, no spaces.
#
# Compose reads this file for ${VAR} values and passes it to the web (and backup) containers, so
# always run:  docker compose --env-file .env.production -f compose.prod.yml <command>

# --- Public site -----------------------------------------------------------------------------
# No trailing slash. Also a BUILD-time value: the image is built with this (repository variable
# NEXT_PUBLIC_SERVER_URL in GitHub); changing it here alone does not change the built pages.
NEXT_PUBLIC_SERVER_URL=https://dmdailydeals.com

# --- Image -----------------------------------------------------------------------------------
# Which image tag compose runs: "latest", or a pinned "sha-1a2b3c4". The deploy workflow rewrites
# this line; edit it to roll back.
WEB_IMAGE_TAG=latest

# --- Database (Postgres 17 in this stack) ----------------------------------------------------
POSTGRES_USER=dmdd
POSTGRES_DB=dmdailydeals
# openssl rand -hex 24
POSTGRES_PASSWORD=
# Password for the separate `umami` role/database, created on first start. openssl rand -hex 24
UMAMI_DB_PASSWORD=

# --- App secrets -----------------------------------------------------------------------------
# Encrypts Payload sessions. Changing it logs everyone out. openssl rand -hex 32
PAYLOAD_SECRET=
# Bearer secret for /api/payload-jobs/run (the cron containers send it). openssl rand -hex 32
CRON_SECRET=
# Secret for draft/live preview requests. openssl rand -hex 32
PREVIEW_SECRET=
# Umami session secret. openssl rand -hex 32
UMAMI_APP_SECRET=

# --- Optional: where the app calls itself (cache warm-up after a drop) ------------------------
# Default http://127.0.0.1:3000 is right inside the web container. Leave unset.
# INTERNAL_SERVER_URL=http://127.0.0.1:3000

# --- Analytics (Umami) -----------------------------------------------------------------------
# BUILD-time values (set them as GitHub repository variables). Listed here for reference only.
# After the first deploy: log in to Umami, create the website, then set the variables and redeploy.
# NEXT_PUBLIC_UMAMI_SRC=https://stats.dmdailydeals.com/script.js
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_DOMAINS=dmdailydeals.com,www.dmdailydeals.com

# --- IndexNow (Bing, Yandex, ...) ------------------------------------------------------------
# 8-128 chars of a-zA-Z0-9-. The app serves it at /indexnow-key.txt. openssl rand -hex 16
INDEXNOW_KEY=

# --- Telegram channel posts (leave both empty to disable) ------------------------------------
# Bot token from @BotFather; the bot must be an admin of the channel.
TELEGRAM_BOT_TOKEN=
# @channelname (public channel) or -100xxxxxxxxxx
TELEGRAM_CHANNEL_ID=

# --- AI blog drafts (leave keys empty to keep drafts off) -------------------------------------
# SET A MONTHLY SPEND LIMIT in the provider's console before adding a key (decision D9).
# deepseek | openai. Site settings can override.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# Optional: a different endpoint (gateway) and a model id (beats Site settings). Delete when unused.
# AI_BASE_URL=
# AI_MODEL=
# Tavily search key for the research step (free tier: 1,000 credits a month)
TAVILY_API_KEY=

# --- Backups (service `backup`) --------------------------------------------------------------
# Daily time in UTC and local retention. Defaults shown.
BACKUP_AT=03:00
RETENTION_DAYS=14
# Off-VPS copy with rclone. Unset = local only. Example for Backblaze B2 (or any rclone remote):
#   RCLONE_REMOTE=offsite:dmdailydeals-backups
#   RCLONE_CONFIG_OFFSITE_TYPE=b2
#   RCLONE_CONFIG_OFFSITE_ACCOUNT=<keyID>
#   RCLONE_CONFIG_OFFSITE_KEY=<applicationKey>
# RCLONE_RETENTION_DAYS=30
